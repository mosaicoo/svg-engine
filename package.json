{
  "name": "svgengine",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "assemble:ml": "node scripts/assemble-whisper-model.mjs",
    "prestart": "npm run assemble:ml",
    "start": "ng serve",
    "prebuild": "npm run assemble:ml",
    "build": "ng build",
    "build:lib": "ng build svg-engine",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:lib": "ng test svg-engine --watch=false",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:serve": "ng serve playground --port 4200",
    "prepare": "husky",
    "strip:maps": "node scripts/strip-sourcemaps.mjs",
    "check:version": "node scripts/check-version-lockstep.mjs",
    "dist:prepare": "npm run check:version && npm run build:lib && npm run strip:maps",
    "pack:lib": "npm run dist:prepare && cd dist/svg-engine && npm pack --dry-run",
    "publish:lib": "npm run dist:prepare && cd dist/svg-engine && npm publish",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:first": "standard-version --first-release"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.11",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@huggingface/transformers": "^4.2.0",
    "polygon-clipping": "^0.15.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "standard-version": "9.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css,yml,yaml}": "prettier --write"
  }
}
