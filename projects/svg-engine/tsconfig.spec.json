/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "core/src/**/*.d.ts",
    "core/src/**/*.spec.ts",
    "render/src/**/*.d.ts",
    "render/src/**/*.spec.ts",
    "io/src/**/*.d.ts",
    "io/src/**/*.spec.ts",
    "optimize/src/**/*.d.ts",
    "optimize/src/**/*.spec.ts",
    "edit/src/**/*.d.ts",
    "edit/src/**/*.spec.ts",
    "ui/src/**/*.d.ts",
    "ui/src/**/*.spec.ts",
    "ai/nlu/src/**/*.d.ts",
    "ai/nlu/src/**/*.spec.ts",
    "ai/nlu-ui/src/**/*.d.ts",
    "ai/nlu-ui/src/**/*.spec.ts"
  ]
}
